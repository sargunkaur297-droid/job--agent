# Copy this file to .env and fill it in. NEVER commit .env.

# Google Gemini API key (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the DB location (default: data/jobs.db)
# JOB_AGENT_DB=data/jobs.db

# Used by GitHub Actions only (paste full contents of token.json as a repo secret).
# Locally the app reads token.json directly.
# GMAIL_TOKEN_JSON=

# Optional: provide resume text via env instead of a file in resume/
# RESUME_TEXT=
